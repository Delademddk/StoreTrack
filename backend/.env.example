JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://localhost:5177"]

DATABASE_SERVER=<YOUR_SQL_SERVER_HOST>
DATABASE_PORT=1433
DATABASE_NAME=StoreTrack
DATABASE_USER=<YOUR_DATABASE_USER>
DATABASE_PASSWORD=<YOUR_DATABASE_PASSWORD>
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_TRUSTED_CONNECTION=no
DATABASE_ENCRYPT=yes
DATABASE_TRUST_SERVER_CERTIFICATE=no

PRODUCT_IMAGE_UPLOAD_DIR=uploads/products
PRODUCT_IMAGE_MAX_SIZE_MB=5
